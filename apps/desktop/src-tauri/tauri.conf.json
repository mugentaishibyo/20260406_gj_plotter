{
  "productName": "GJ-Voiplotter",
  "version": "0.1.0",
  "identifier": "com.gj-voiplotter.app",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build",
    "devPath": "http://localhost:5173",
    "distDir": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GJ-Voiplotter",
        "width": 800,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
