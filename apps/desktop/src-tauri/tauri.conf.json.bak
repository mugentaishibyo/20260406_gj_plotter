{
  "productName": "GJVoiplotter",
  "version": "1.0.0",
  "identifier": "com.gjvoiplotter.app",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build",
    "devPath": "http://localhost:5173",
    "distDir": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GJVoiplotter",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
