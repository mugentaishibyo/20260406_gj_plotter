{
  "$schema": "../gen/schemas/desktop-capability.json",
  "identifier": "default",
  "description": "Default capability for the desktop application",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "shell:default",
    "fs:default",
    "fs:allow-appconfig-recursive",
    "fs:allow-appconfig-write-recursive",
    "fs:allow-appconfig-read-recursive",
    "opener:default"
  ]
}
