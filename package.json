{
  "name": "gjvoiplotter-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "web:dev": "npm run dev -w @gjvoiplotter/web",
    "web:build": "npm run build -w @gjvoiplotter/web",
    "desktop:dev": "npm run tauri dev -w @gjvoiplotter/desktop",
    "desktop:build": "npm run tauri build -w @gjvoiplotter/desktop",
    "mobile:dev": "npm run dev -w @gjvoiplotter/mobile",
    "mobile:build": "npm run build -w @gjvoiplotter/mobile"
  }
}
